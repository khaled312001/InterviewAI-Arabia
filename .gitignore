# Dependencies
node_modules/
.pnpm-store/

# Env
.env
.env.local
.env.*.local
!.env.example

# Build output (rebuilt by Vercel on each deploy via build:vercel)
dist/
build/
public/
# ...except the admin's static source assets (self-hosted Cairo woff2), which
# are inputs to the build, not output.
!admin/public/
.next/
.expo/
.expo-shared/
*.tsbuildinfo

# Prisma
backend/prisma/*.db
backend/prisma/migrations/dev.db*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Mobile builds
android/app/build/
android/build/
ios/build/
*.apk
*.aab
*.ipa
*.keystore
!debug.keystore

# Admin build artefacts
admin/dist/

# PM2
.pm2/

# Runtime
pids
*.pid
*.seed

# Local Claude Code state (not project code)
.claude/

# Signing keys and build artefacts — never commit these.
*.jks
release/

# Native projects are generated by `expo prebuild` on every build (see
# scripts/build-android.sh) and must never be hand-edited or committed —
# a stale checked-in copy silently overrides app.json.
mobile/android/
mobile/ios/

# Local regression-test exports (scripts/serve-webtest.mjs)
.webtest*/

# OAuth client downloads from Google Cloud Console.
#
# An "installed"/Android client JSON holds no secret — the client id is public
# and ships inside the app. A WEB client JSON downloaded from the same screen
# holds `client_secret`, looks identical, and is named the same way. Ignoring
# the whole pattern means the dangerous one cannot be committed by accident on
# a day when nobody checked which kind it was.
client_secret_*.json

# Firebase
#
# google-services.json is not a secret (it ships inside the APK and only
# identifies the project), but it is environment-specific — committing it means
# a fork or a second Firebase project silently builds against the wrong one.
google-services.json
mobile/google-services.json
GoogleService-Info.plist
mobile/GoogleService-Info.plist

# The Admin SDK service account IS a secret: its private key can send a push to
# every installed app, read the database and mint custom auth tokens. It must
# never be committed, and it must never be served from the web root.
*-firebase-adminsdk-*.json
firebase-service-account.json
