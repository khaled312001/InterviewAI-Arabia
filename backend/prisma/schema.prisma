// Prisma schema — InterviewAI Arabia
//
// Target: MySQL 8 on Hostinger, served by a single long-running Node process
// behind LiteSpeed/Passenger. The query engine runs in "library" mode with
// TOKIO_WORKER_THREADS=1 (see server.cjs) — spawning a child process for the
// engine is restricted on this box and panics at runtime otherwise.

generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  // Hostinger's CloudLinux ships OpenSSL 1.1.x with Node 20; list the 1.1.x
  // targets first so Prisma picks a matching engine instead of panicking.
  binaryTargets = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------- enums -------------------------------

enum Language {
  ar
  en
}

enum Plan {
  free
  premium
}

enum Difficulty {
  easy
  medium
  hard
}

enum SubscriptionStatus {
  pending
  active
  expired
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  expired
}

enum PaymentProvider {
  easykash
  paymob
  google_play
  manual
}

enum AdminRole {
  super_admin
  moderator
  content_editor
}

enum SessionKind {
  practice
  meeting
}

// --------------------------- minute metering --------------------------

/// Why a row exists on the ledger. `consumption` and `expiry` are the only
/// negative kinds; everything else adds seconds.
enum TimeLedgerKind {
  trial_grant
  purchase
  subscription_grant
  promo_grant
  admin_grant
  consumption
  refund
  expiry
  adjustment
}

/// Which counter the row moved. Perpetual seconds never expire; subscription
/// seconds die with the cycle, which is why they are spent first.
enum TimeBucket {
  perpetual
  subscription
}

enum MeetingStatus {
  live
  ended
  abandoned
  exhausted
}

enum TrialClaimType {
  install
  phone
  email
}

// ------------------------------- models ------------------------------

model User {
  id                 BigInt    @id @default(autoincrement())
  email              String    @unique @db.VarChar(191)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  name               String    @db.VarChar(120)
  // EasyKash requires a mobile number on the billing payload. Optional here
  // because existing accounts predate it; collected at checkout time.
  phone              String?   @db.VarChar(32)
  language           Language  @default(ar)
  plan               Plan      @default(free)
  dailyQuestionsUsed Int       @default(0) @map("daily_questions_used")
  // Stored as a plain DATE in Africa/Cairo terms, not UTC — the "day" a user
  // experiences is their local day. See services/quota.js.
  lastResetDate      DateTime? @map("last_reset_date") @db.Date
  // Denormalised mirror of the newest active subscription's expiry so the
  // hot path (every answer submission) never joins subscriptions.
  premiumUntil       DateTime? @map("premium_until")

  // ------------------------- minute balance --------------------------
  // Seconds, never minutes: minutes are a display unit, and storing the
  // display unit is how a charge ends up rounded twice.
  //
  // These two counters are a denormalised cache of `time_ledger`, in exactly
  // the same relationship `premiumUntil` has with `subscriptions`. The ledger
  // is the record; the counters are what the 15-second meeting tick reads.
  // maintenance.js:reconcileBalances() asserts nightly that they agree.

  /// Perpetual seconds: free trial + purchased packs + admin grants. Never expires.
  balanceSeconds      Int       @default(0) @map("balance_seconds")
  /// The current subscription cycle's allowance. Expires with the cycle, and is
  /// therefore spent BEFORE balanceSeconds — the perishable currency goes first,
  /// so a subscriber never burns cash-bought minutes while their allowance rots.
  subSeconds          Int       @default(0) @map("sub_seconds")
  subSecondsExpiresAt DateTime? @map("sub_seconds_expires_at")
  /// Sum of the outstanding reservations of this user's LIVE meetings. A hold,
  /// not a spend: available = validSub + balance - held.
  heldSeconds         Int       @default(0) @map("held_seconds")
  /// The free trial's lock. Set exactly once, by an atomic conditional UPDATE.
  trialGrantedAt      DateTime? @map("trial_granted_at")
  trialSeconds        Int       @default(0) @map("trial_seconds")
  /// The "your free minutes are waiting" reminder's lock, and the same shape as
  /// the one above for the same reason: the job that sends it runs from two
  /// schedulers at once, so the claim has to be the UPDATE's WHERE clause. NULL
  /// means never reminded; it is written once and never cleared.
  trialRemindedAt     DateTime? @map("trial_reminded_at")

  /// Google's stable subject id for this account, when they signed in with
  /// Google. NOT the email: a Google account's address can change and this
  /// cannot, so matching on it is what stops a rename creating a second user.
  googleSub String? @unique @map("google_sub") @db.VarChar(64)
  /// Profile picture URL from the identity provider. Display only.
  avatarUrl String? @map("avatar_url") @db.VarChar(512)

  isDisabled      Boolean   @default(false) @map("is_disabled")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions        Session[]
  subscriptions   Subscription[]
  payments        Payment[]
  reports         AnswerReport[]
  passwordResets  PasswordReset[]
  refreshTokens   RefreshToken[]
  timeLedger      TimeLedgerEntry[]
  meetingSessions MeetingSession[]
  trialClaims     TrialClaim[]
  deviceTokens    DeviceToken[]
  notifications   Notification[]

  @@index([plan, premiumUntil])
  @@index([createdAt])
  @@index([subSecondsExpiresAt])
  /// The daily trial-reminder sweep's selection: "never reminded, granted a
  /// while ago". Without it that is a full table scan once a day.
  @@index([trialRemindedAt, trialGrantedAt], map: "users_trial_reminder_idx")
  @@map("users")
}

model Category {
  id            Int      @id @default(autoincrement())
  nameAr        String   @map("name_ar") @db.VarChar(120)
  nameEn        String   @map("name_en") @db.VarChar(120)
  descriptionAr String?  @map("description_ar") @db.VarChar(500)
  descriptionEn String?  @map("description_en") @db.VarChar(500)
  icon          String?  @db.VarChar(64)
  isPremium     Boolean  @default(false) @map("is_premium")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  questions Question[]
  sessions  Session[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Question {
  id         BigInt     @id @default(autoincrement())
  categoryId Int        @map("category_id")
  questionAr String     @map("question_ar") @db.Text
  questionEn String     @map("question_en") @db.Text
  difficulty Difficulty @default(medium)
  usageCount Int        @default(0) @map("usage_count")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  answers  Answer[]

  @@index([categoryId, isActive, difficulty])
  @@index([categoryId, isActive, usageCount])
  @@map("questions")
}

model Session {
  id            BigInt      @id @default(autoincrement())
  userId        BigInt      @map("user_id")
  categoryId    Int         @map("category_id")
  kind          SessionKind @default(practice)
  totalScore    Int         @default(0) @map("total_score")
  // Denormalised so History/Stats never need a COUNT subquery per row.
  answerCount   Int         @default(0) @map("answer_count")
  /// Denormalised from meeting_sessions, in the same spirit as answerCount, so
  /// History can render "٧ دقائق" without joining the billing table.
  billedSeconds Int         @default(0) @map("billed_seconds")
  startedAt     DateTime    @default(now()) @map("started_at")
  endedAt       DateTime?   @map("ended_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category         @relation(fields: [categoryId], references: [id])
  answers         Answer[]
  meetingSessions MeetingSession[]

  @@index([userId, startedAt])
  @@index([userId, kind, startedAt])
  @@map("sessions")
}

model Answer {
  id           BigInt   @id @default(autoincrement())
  sessionId    BigInt   @map("session_id")
  // Nullable: live "meeting" answers are free-form and have no row in
  // `questions`. The old code pointed these at a hardcoded question id 1,
  // which is a foreign key lie that corrupts per-question usage stats.
  questionId   BigInt?  @map("question_id")
  questionText String?  @map("question_text") @db.Text
  userAnswer   String   @map("user_answer") @db.Text
  aiScore      Int?     @map("ai_score")
  aiFeedback   String?  @map("ai_feedback") @db.LongText
  tokensUsed   Int?     @map("tokens_used")
  createdAt    DateTime @default(now()) @map("created_at")

  session  Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question?      @relation(fields: [questionId], references: [id], onDelete: SetNull)
  reports  AnswerReport[]

  @@index([sessionId])
  @@index([createdAt])
  @@map("answers")
}

// ---------------------------- monetisation ----------------------------

model Subscription {
  id          BigInt             @id @default(autoincrement())
  userId      BigInt             @map("user_id")
  provider    PaymentProvider    @default(easykash)
  // The gateway's own reference for this subscription/order. Replaces the
  // old `google_purchase_token`, which forced every provider through a
  // Google-Play-shaped column.
  providerRef String             @unique @map("provider_ref") @db.VarChar(191)
  planCode    String             @map("plan_code") @db.VarChar(64)
  status      SubscriptionStatus @default(pending)
  autoRenew   Boolean            @default(false) @map("auto_renew")
  startedAt   DateTime           @default(now()) @map("started_at")
  expiresAt   DateTime           @map("expires_at")
  cancelledAt DateTime?          @map("cancelled_at")
  rawPayload  String?            @map("raw_payload") @db.LongText
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("subscriptions")
}

/// One row per payment attempt. This is the audit trail the old schema had
/// no room for — reconciliation, refunds, and failed attempts all need it.
model Payment {
  id             BigInt          @id @default(autoincrement())
  userId         BigInt          @map("user_id")
  subscriptionId BigInt?         @map("subscription_id")
  provider       PaymentProvider @default(easykash)
  /// Our own reference, sent to the gateway and echoed back on the webhook.
  /// This is what makes a webhook matchable to a user without trusting
  /// anything user-controlled in the callback body.
  reference      String          @unique @map("reference") @db.VarChar(191)
  /// The gateway's transaction id, known only after payment.
  providerTxnId  String?         @map("provider_txn_id") @db.VarChar(191)
  planCode       String          @map("plan_code") @db.VarChar(64)
  /// Integer minor units (piastres for EGP). Never store money as a float.
  amountCents    Int             @map("amount_cents")
  currency       String          @default("EGP") @db.VarChar(8)
  status         PaymentStatus   @default(pending)
  method         String?         @db.VarChar(64)
  failureReason  String?         @map("failure_reason") @db.VarChar(500)
  paidAt         DateTime?       @map("paid_at")
  refundedAt     DateTime?       @map("refunded_at")
  rawPayload     String?         @map("raw_payload") @db.LongText
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  timeLedger   TimeLedgerEntry[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([providerTxnId])
  @@map("payments")
}

// -------------------------- minute metering ---------------------------

/// Append-only. Rows are NEVER updated or deleted — a correction is another
/// row. This is what makes "where did my minutes go?" a SELECT rather than a
/// data-archaeology project; every metering bug in this product's history was
/// undiagnosable precisely because only the current value was stored.
model TimeLedgerEntry {
  id                BigInt         @id @default(autoincrement())
  userId            BigInt         @map("user_id")
  kind              TimeLedgerKind
  bucket            TimeBucket     @default(perpetual)
  /// Signed. +3600 for a 60-minute pack, -442 for a 7m22s interview.
  seconds           Int
  /// Both counters as they stood immediately after this row was written.
  /// Makes counter/ledger drift locatable without replaying the whole history.
  perpetualAfter    Int            @map("perpetual_after")
  subscriptionAfter Int            @map("subscription_after")
  paymentId         BigInt?        @map("payment_id")
  subscriptionId    BigInt?        @map("subscription_id")
  meetingSessionId  BigInt?        @map("meeting_session_id")
  adminId           BigInt?        @map("admin_id")
  /// The one thing that makes a grant safe to retry. `payment:<id>`,
  /// `trial:<userId>`, `sub:<subId>:cycle:<n>`, `meeting:<id>:settle:<n>`.
  idempotencyKey    String?        @unique @map("idempotency_key") @db.VarChar(191)
  note              String?        @db.VarChar(255)
  createdAt         DateTime       @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment        Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  meetingSession MeetingSession? @relation(fields: [meetingSessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@map("time_ledger")
}

/// The server-side clock for one live interview.
///
/// Deliberately NOT columns on `sessions`: the two rows have different
/// lifecycles and different audiences. `sessions` is the PRODUCT record the
/// user browses in History and is created only at /finish; this is the BILLING
/// record, created at /meeting/start and ticked from the first second. Creating
/// `sessions` rows up front would fill every user's History with abandoned
/// twelve-second meetings that produced nothing.
model MeetingSession {
  id                   BigInt        @id @default(autoincrement())
  userId               BigInt        @map("user_id")
  categoryId           Int           @map("category_id")
  /// Populated at /finish. NULL for meetings that produced nothing.
  sessionId            BigInt?       @map("session_id")
  status               MeetingStatus @default(live)
  /// Seconds currently reserved against this meeting (part of users.held_seconds).
  heldSeconds          Int           @default(0) @map("held_seconds")
  /// Seconds accrued so far. `billedSeconds - (subSecondsUsed + perpetualSecondsUsed)`
  /// is the amount not yet moved out of the hold and onto the ledger.
  billedSeconds        Int           @default(0) @map("billed_seconds")
  /// Wall-clock deliberately NOT charged: network drops, backgrounded app,
  /// phone asleep. Surfaced to the user after the interview — this number is
  /// the whole trust argument for the model.
  skippedSeconds       Int           @default(0) @map("skipped_seconds")
  subSecondsUsed       Int           @default(0) @map("sub_seconds_used")
  perpetualSecondsUsed Int           @default(0) @map("perpetual_seconds_used")
  turnCount            Int           @default(0) @map("turn_count")
  /// `billedSeconds` as it stood at the previous /turn. The turn floor is a
  /// TOP-UP to `meeting_min_turn_seconds` measured against the wall-clock
  /// accrued since the last turn — without this column the floor would be
  /// measured against the last 15-second tick and would bind on every turn of
  /// an honest client, which is exactly what it must never do.
  billedAtLastTurn     Int           @default(0) @map("billed_at_last_turn")
  /// Server clock only. A client-supplied timestamp never touches these.
  startedAt            DateTime      @default(now()) @map("started_at")
  lastTickAt           DateTime      @default(now()) @map("last_tick_at")
  endedAt              DateTime?     @map("ended_at")
  /// 'user_ended' | 'exhausted' | 'abandoned' | 'evaluated' | 'admin'
  endReason            String?       @map("end_reason") @db.VarChar(32)
  client               String?       @db.VarChar(32)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  ledger  TimeLedgerEntry[]

  @@index([userId, startedAt])
  /// The sweeper's index: find live meetings whose tick went stale.
  @@index([status, lastTickAt])
  @@map("meeting_sessions")
}

/// One row per identity signal a free trial was claimed against. The unique
/// index is the entire anti-abuse mechanism — it stops casual double-dipping
/// and, until email verification exists, nothing more. See services/billing.
model TrialClaim {
  id        BigInt         @id @default(autoincrement())
  userId    BigInt         @map("user_id")
  claimType TrialClaimType @map("claim_type")
  /// SHA-256(salt || value). Hashed so a database leak is not a device map.
  claimHash String         @map("claim_hash") @db.VarChar(64)
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([claimType, claimHash])
  @@index([userId])
  @@map("trial_claims")
}

/// Webhook de-duplication. Gateways retry aggressively and will happily
/// deliver the same success event several times; without this a user could
/// be granted (or charged for) the same month repeatedly.
model WebhookEvent {
  id          BigInt          @id @default(autoincrement())
  provider    PaymentProvider
  /// Provider event id, or a hash of the payload when none is supplied.
  externalId  String          @map("external_id") @db.VarChar(191)
  payload     String          @db.LongText
  processedAt DateTime?       @map("processed_at")
  error       String?         @db.VarChar(500)
  createdAt   DateTime        @default(now()) @map("created_at")

  @@unique([provider, externalId])
  @@index([createdAt])
  @@map("webhook_events")
}

// ------------------------------- auth --------------------------------

/// Refresh tokens are stored hashed so a database leak can't be replayed,
/// and so logout / "sign out everywhere" can actually revoke a session.
/// The old build issued stateless refresh JWTs with no revocation path.
model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ip        String?   @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("password_resets")
}

model AdminUser {
  id           BigInt    @id @default(autoincrement())
  email        String    @unique @db.VarChar(191)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String    @db.VarChar(120)
  role         AdminRole @default(moderator)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  auditLogs AdminAuditLog[]

  @@map("admin_users")
}

/// Every state-changing admin action. Without this there is no way to tell
/// which admin disabled an account, deleted a question, or issued a refund.
model AdminAuditLog {
  id         BigInt   @id @default(autoincrement())
  adminId    BigInt   @map("admin_id")
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  metadata   String?  @db.Text
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
  @@map("admin_audit_logs")
}

model AnswerReport {
  id         BigInt   @id @default(autoincrement())
  answerId   BigInt   @map("answer_id")
  reporterId BigInt   @map("reporter_id")
  reason     String   @db.VarChar(255)
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reporterId], references: [id])

  @@index([resolved, createdAt])
  @@map("answer_reports")
}

// ------------------------------ telemetry -----------------------------

/// Kept at the original table name (`claude_api_logs`) so the live database
/// needs no data migration, but widened: we now track which product feature
/// spent the tokens and what it cost, which is what makes per-user cost caps
/// and margin reporting possible.
model AiUsageLog {
  id               BigInt   @id @default(autoincrement())
  userId           BigInt?  @map("user_id")
  provider         String   @default("claude") @db.VarChar(32)
  model            String   @db.VarChar(64)
  feature          String   @default("evaluate") @db.VarChar(32)
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int      @default(0) @map("cache_write_tokens")
  /// Cost in micro-USD (1e-6 USD) — integer maths, no float drift.
  costMicroUsd     Int      @default(0) @map("cost_micro_usd")
  latencyMs        Int      @map("latency_ms")
  success          Boolean  @default(true)
  errorMessage     String?  @map("error_message") @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@map("claude_api_logs")
}

model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// Integration credentials — deliberately NOT app_settings.
///
/// GET /admin/settings returns every app_settings row in the clear to every
/// admin role, content_editor included. Putting the EasyKash API key there
/// would hand it to the lowest-privileged account in the system. This table is
/// super_admin-only, secrets are AES-256-GCM encrypted with the key name bound
/// in as AAD, and no endpoint ever returns `valueEnc`.
model ProviderCredential {
  key        String   @id @db.VarChar(100)
  /// Secrets are encrypted into valueEnc; clear config lives in valuePlain.
  isSecret   Boolean  @default(true) @map("is_secret")
  valueEnc   String?  @map("value_enc") @db.Text
  valuePlain String?  @map("value_plain") @db.Text
  /// The only fragment of a secret any response may contain.
  last4      String?  @db.VarChar(8)
  updatedBy  BigInt?  @map("updated_by")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("provider_credentials")
}

/// One row per (device, account). See migration 006.
///
/// The FCM registration token is the id, not an autoincrement: it is globally
/// unique and is what FCM addresses, so "the same device signed in again" is an
/// upsert instead of a second live row pointing at one handset.
model DeviceToken {
  token      String    @id @db.VarChar(255)
  /// Nullable so a token survives sign-out — the device is still reachable, it
  /// just is not anybody's any more. Deleting on sign-out is why "notify me
  /// when I log back in" quietly stops working.
  userId     BigInt?   @map("user_id")
  platform   String    @default("android") @db.VarChar(16)
  /// Per DEVICE, not per account: the same person may read Arabic on a phone
  /// and English on the web.
  language   String    @default("ar") @db.VarChar(8)
  installId  String?   @map("install_id") @db.VarChar(191)
  appVersion String?   @map("app_version") @db.VarChar(32)
  /// Set when FCM reports the token dead. Soft-retired, so a broadcast's
  /// denominator stays honest.
  disabledAt DateTime? @map("disabled_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, disabledAt])
  @@index([disabledAt, platform])
  @@map("device_tokens")
}

/// What was sent, to whom, and whether it landed. See migration 006.
model Notification {
  id          BigInt   @id @default(autoincrement())
  titleAr     String   @map("title_ar") @db.VarChar(200)
  bodyAr      String   @map("body_ar") @db.VarChar(500)
  titleEn     String?  @map("title_en") @db.VarChar(200)
  bodyEn      String?  @map("body_en") @db.VarChar(500)
  /// Where a tap lands, e.g. 'Subscription'. Read by the app from the payload.
  route       String?  @db.VarChar(64)
  audience    String   @default("all") @db.VarChar(32)
  userId      BigInt?  @map("user_id")
  /// 'manual' for an operator broadcast, or the event name for an automatic one.
  kind        String   @default("manual") @db.VarChar(48)
  sentCount   Int      @default(0) @map("sent_count")
  failedCount Int      @default(0) @map("failed_count")
  createdBy   BigInt?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@map("notifications")
}
