# InterviewAI Arabia — backend configuration
#
# Copy to .env on the server and fill in real values. Never commit .env.
# In production the app REFUSES TO START if a required value is missing or
# invalid — that is deliberate. Booting with a broken security config is
# worse than not booting.

# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# Public origin. Used to build payment redirect/callback URLs, so it must be
# the exact scheme+host users reach — a wrong value silently breaks checkout.
APP_URL=https://interprova.com

# Note: a password containing reserved URL characters must be percent-encoded.
# e.g. a literal "|" becomes %7C, "@" becomes %40, "#" becomes %23.
DATABASE_URL="mysql://user:percent%20encoded%20password@127.0.0.1:3306/dbname"

# Minimum 32 characters. Changing this signs out every user immediately.
JWT_SECRET=generate-with-node-e-require-crypto-randomBytes-48-toString-hex
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── AI ──────────────────────────────────────────────────────────────────
# Set ANTHROPIC_API_KEY, then flip AI_ENABLED=true. While AI_ENABLED=false
# every AI route returns 503 and NO user quota is consumed.
AI_ENABLED=false
AI_PROVIDER=claude

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model choice is the single biggest lever on unit cost. Per-call cost is
# recorded in the claude_api_logs table (cost_micro_usd), so measure before
# switching rather than guessing:
#   claude-opus-5     $5 / $25  per Mtok — best Arabic evaluation quality
#   claude-sonnet-5   $3 / $15  per Mtok — ~60% cheaper, still strong
#   claude-haiku-4-5  $1 / $5   per Mtok — cheapest, noticeably shallower
CLAUDE_MODEL=claude-opus-5

# Optional fallback provider — used only if the Anthropic key is absent or
# failing, so the product degrades instead of dying.
GROQ_API_KEY=
AI_MODEL=

# ── EasyKash (Egypt) ────────────────────────────────────────────────────
# With both flags false, /api/payments/checkout returns 503. That is the safe
# default: it is better to sell nothing than to hand out free premium.
EASYKASH_ENABLED=false

# Simulates the whole checkout → callback → activation flow with no gateway
# and no real money, so payments can be tested before credentials exist.
# NEVER enable this in production — it grants premium for free.
EASYKASH_MOCK=false

EASYKASH_BASE_URL=https://back.easykash.net
EASYKASH_PAY_PATH=/api/directpayv1/pay

# From your EasyKash merchant dashboard.
EASYKASH_API_KEY=
EASYKASH_WEBHOOK_SECRET=

# How EasyKash signs callbacks. Confirm these against the integration PDF in
# your dashboard, then verify against one real callback before going live —
# a wrong field order means every genuine payment is rejected.
EASYKASH_SIGNATURE_ALGO=sha256
EASYKASH_SIGNATURE_FIELDS=Amount,PaymentMethod,ProductCode,easykashRef,customerReference,status
# Header carrying the signature; leave blank to read it from the JSON body.
EASYKASH_SIGNATURE_HEADER=

# Methods offered on the hosted checkout page.
EASYKASH_PAYMENT_OPTIONS=CARD,FAWRY,WALLET

# ── Access control ──────────────────────────────────────────────────────
# Comma-separated exact origins. Never "*" — it is ignored with credentials
# and only creates false confidence.
CORS_ORIGINS=https://interprova.com

FREE_DAILY_QUESTION_LIMIT=5

# Required for the HTTP cron routes. With it empty every cron request is
# rejected (there is no loopback bypass — that was an auth hole).
CRON_SECRET=

# /api/diag reveals which secrets are configured, so it is off by default and
# token-gated when on.
DIAG_ENABLED=false
DIAG_TOKEN=

# Used only to bootstrap the first admin on seed.
ADMIN_EMAIL=admin@barmagly.tech
ADMIN_PASSWORD=
